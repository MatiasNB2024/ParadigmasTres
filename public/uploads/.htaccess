# Carpeta de imágenes subidas por el administrador.
# Nunca se ejecuta código aquí: solo se sirven imágenes.
Options -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php\d|pht|shtml|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
